@model SmartResumeAnalyzer.Models.ProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="analyze-container">
    <div class="analyze-box animate-on-load">
        <div class="section-header">
            <span class="eyebrow">Profile Settings</span>
            <h1>Update your account details</h1>
        </div>

        <p class="analyze-description">Change your name, email, and contact details for your account.</p>

        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="alert alert-success">@TempData["ProfileSuccess"]</div>
        }
        @if (TempData["ProfileError"] != null)
        {
            <div class="alert alert-danger">@TempData["ProfileError"]</div>
        }

        <form asp-action="EditProfile" method="post">
            <div class="form-group">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" class="form-control" placeholder="Your full name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Contact">Phone or contact info</label>
                <input asp-for="Contact" class="form-control" placeholder="+1 555 123 4567" />
                <span asp-validation-for="Contact" class="text-danger"></span>
            </div>

            <button type="submit" class="analyze-btn">Save changes</button>
            <a asp-action="Profile" class="btn action-btn outline ms-2">Cancel</a>
        </form>
    </div>
</div>

