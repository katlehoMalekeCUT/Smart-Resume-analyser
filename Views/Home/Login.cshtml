@model SmartResumeAnalyzer.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth-page">
    <div class="auth-frame animate-on-load">
        <div class="auth-aside">
            <span class="eyebrow">Secure login</span>
            <h2>Welcome back to Smart Resume Analyzer.</h2>
            <p>Login to access your resume analyzer, view history, and get instant ATS feedback.</p>
            <ul>
                <li>One-click resume upload</li>
                <li>Saved progress and insights</li>
                <li>Personalized recommendations</li>
            </ul>
            <a class="ghost-btn" asp-action="Register">Create an account</a>
        </div>

        <div class="auth-card">
            <h2>Login</h2>
            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-info">@TempData["Message"]</div>
                }
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <p class="auth-hint"><a asp-action="ForgotPassword">Forgot password?</a></p>
                </div>

                <div class="form-check custom-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" id="RememberMe" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primary btn-submit">Log in</button>
                <p class="auth-hint">New here? <a asp-action="Register">Register instead</a></p>
            </form>

            @section Scripts {
                <partial name="_ValidationScriptsPartial" />
            }
        </div>
    </div>
</div>