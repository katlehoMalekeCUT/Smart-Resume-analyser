@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-page">
    <div class="auth-frame animate-on-load">
        <div class="auth-aside">
            <span class="eyebrow">Account recovery</span>
            <h2>Forgot your password?</h2>
            <p>No worries — enter the email linked to your account and we'll send you a 6-digit code to reset your password.</p>
            <ul>
                <li>Quick email verification</li>
                <li>Secure code-based reset</li>
                <li>Back to your account in minutes</li>
            </ul>
            <a class="ghost-btn" asp-action="Login">Back to login</a>
        </div>

        <div class="auth-card">
            <h2>Forgot password</h2>
            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control" placeholder="you@example.com" required />
                </div>

                <button type="submit" class="btn btn-primary btn-submit">Send code</button>
                <p class="auth-hint">Remembered it? <a asp-action="Login">Log in instead</a></p>
            </form>
        </div>
    </div>
</div>