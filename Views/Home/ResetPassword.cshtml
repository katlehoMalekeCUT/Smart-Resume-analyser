@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-page">
    <div class="auth-frame animate-on-load">
        <div class="auth-aside">
            <span class="eyebrow">Account recovery</span>
            <h2>Reset your password</h2>
            <p>We sent a 6-digit code to <strong>@ViewBag.Email</strong>. Enter it below along with your new password.</p>
            <ul>
                <li>Enter the code from your email</li>
                <li>Choose a strong new password</li>
                <li>Log back in right away</li>
            </ul>
            <a class="ghost-btn" asp-action="Login">Back to login</a>
        </div>

        <div class="auth-card">
            <h2>Reset password</h2>
            <form asp-action="ResetPassword" method="post">
                <input type="hidden" name="email" value="@ViewBag.Email" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Verification code</label>
                    <input type="text" name="code" maxlength="6" class="form-control" placeholder="123456" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">New password</label>
                    <input type="password" name="newPassword" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirm new password</label>
                    <input type="password" name="confirmPassword" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-primary btn-submit">Reset password</button>
                <p class="auth-hint">Didn't get a code? <a asp-action="ForgotPassword">Try again</a></p>
            </form>
        </div>
    </div>
</div>